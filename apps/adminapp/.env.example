# From sentry.io -> Settings -> Projects -> <project> -> Client Keys (DSN). Leave blank to
# disable Sentry entirely (local dev default). Use a separate Sentry project from mainapp so
# platform-operator errors don't mix with tenant-facing ones.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2

# Must match ADMIN_API_TOKEN in the root .env (auth-service reads it there). Sent as the
# x-admin-token header on every /api/v1/admin/* request. Note this ends up in the built JS
# bundle since adminapp is a static SPA — acceptable for now since adminapp is an internal,
# unlinked console (same risk level as its hardcoded login), but move to real per-admin-user
# auth before this is ever exposed more broadly.
VITE_ADMIN_API_TOKEN=
