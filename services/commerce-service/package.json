{
  "name": "@zetsales/commerce-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint \"**/*.ts\"",
    "postinstall": "node -e \"if(!process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD) require('child_process').execSync('playwright install chromium', {stdio: 'inherit'})\""
  },
  "dependencies": {
    "@zetsales/config": "workspace:*",
    "@zetsales/shared": "workspace:*",
    "axios": "^1.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.18.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.61.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "winston": "^3.17.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.12.12",
    "eslint": "^9.9.0",
    "tsx": "^4.20.3",
    "typescript": "^5.4.5"
  }
}
