JWT_SECRET=super-secret-key-change-me
MONGODB_URI=mongodb://localhost:27017/zetsales
PORT=3000
NODE_ENV=development

# --- adminapp (platform control center) ------------------------------------------------------
# Shared secret checked on every /api/v1/admin/* request (auth-service's requireAdmin
# middleware) — deliberately a single static token rather than per-admin-user auth, matching
# adminapp's hardcoded login for this first pass. Generate any long random string; must match
# VITE_ADMIN_API_TOKEN set in apps/adminapp/.env.
ADMIN_API_TOKEN=

# --- Error tracking (auth-service + commerce-service + messaging-service + api-gateway) -------
# From sentry.io -> Settings -> Projects -> <project> -> Client Keys (DSN). One DSN per service
# is cleanest (separate Sentry projects for auth-service/commerce-service), but a single shared
# DSN also works. Leave blank to disable — the SDK no-ops rather than erroring.
SENTRY_DSN=
# Fraction of requests to capture full performance traces for (0-1). Keep this low in production;
# it only affects trace volume, not error capture, which always happens for real exceptions.
SENTRY_TRACES_SAMPLE_RATE=0.2

# --- Uptime monitor (services/uptime-monitor) -------------------------------------------------
# A Slack Incoming Webhook URL (api.slack.com/messaging/webhooks) — posts an alert the moment a
# service/page goes down, and again when it recovers. Left blank, alerts just print to the
# console instead of failing silently.
SLACK_WEBHOOK_URL=
# How often to run the full check pass, in ms. Defaults to 5 minutes if unset.
MONITOR_CHECK_INTERVAL_MS=300000
# Public URL of adminapp, once it's actually deployed — leave blank to skip that check (mainapp
# and the backend health endpoints are wired to the docker-compose internal network by default
# and don't need this set).
ADMINAPP_URL=

# --- Commerce integrations (Shopify / WooCommerce) -----------------------------------------
# Encrypts stored store credentials (Shopify access tokens, WooCommerce consumer secrets) at rest.
STORE_CREDENTIALS_SECRET=dev-store-credentials-secret-change-me

# Public URLs this backend is reachable at — used to build OAuth redirect / webhook callback URLs.
# For local dev these point at localhost; for a real Shopify OAuth or WooCommerce one-click
# connect flow to work, PUBLIC_COMMERCE_URL must be a real HTTPS address (e.g. via ngrok or a
# deployed server) — both platforms require HTTPS callbacks.
PUBLIC_APP_URL=http://localhost:3000
WORKSPACE_ROOT_DOMAIN=
COOKIE_DOMAIN=
PUBLIC_COMMERCE_URL=http://localhost:8081/api/v1/commerce

# Resend: only needed for password-reset emails. Without it, the reset link is just logged
# server-side instead of emailed — fine for local dev, not for real users. EMAIL_FROM must be an
# address on a domain verified in Resend's Domains tab (SPF/DKIM), e.g. "ZetSales <noreply@zetsales.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Shopify: only needed for the one-click "Connect Shopify" OAuth flow. Create a Partner account +
# custom/public app at partners.shopify.com to get these. Not required for the "paste your
# access token" fallback connection method, which works today with no setup.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Used to verify Shopify order webhook signatures once webhooks are registered for a store.
SHOPIFY_WEBHOOK_SECRET=

# WooCommerce: no account/app registration needed for either connection method. This secret is
# only used to verify order and product webhook signatures once a webhook is registered on a
# connected store.
WOOCOMMERCE_WEBHOOK_SECRET=

# ZetSite: a separate storefront-builder product the same operator owns, connected the same way as
# Shopify/WooCommerce — one-click OAuth, then live two-way product/order sync. Unlike Shopify this
# is one static trusted partner (no Partner account / app review), so all three values below must
# match exactly what's set in zetsite's own .env (ZETSALES_INTEGRATION_SECRET, ZETSITE_WEBHOOK_SECRET).
# zetsite's own public app URL (the builder's origin) — both its OAuth consent screen and its
# products/orders API live under this one base.
ZETSITE_API_URL=
# Sent as the X-Integration-Secret header when exchanging an OAuth code for an access token.
ZETSITE_INTEGRATION_SECRET=
# Verifies the HMAC signature on zetsite's inbound product/order webhooks.
ZETSITE_WEBHOOK_SECRET=

# Alibaba product import: optional. Used by alibabaImporter.ts as a headless-browser proxy
# (scraperapi.com) to get past Alibaba's CAPTCHA gate before falling back to local Playwright.
# Leave blank to skip straight to the local Playwright fallback.
SCRAPER_API_KEY=

# --- Messaging (Facebook Page + Instagram inbox) -------------------------------------------
# Create a Meta App at developers.facebook.com with Messenger + Instagram use cases.
# Same App ID/Secret is reused for the Ad Performance "Connect Meta Ads" integration below — that
# just needs the Marketing API product added to this same app (Add Product -> Marketing API),
# with the ads_read + business_management permissions requested.
META_APP_ID=
META_APP_SECRET=
# Any string you also paste into the Meta App's Webhooks config as the Verify Token.
META_WEBHOOK_VERIFY_TOKEN=
# Encrypts stored Page access tokens at rest.
MESSAGING_CREDENTIALS_SECRET=dev-messaging-credentials-secret-change-me
# Must be a real HTTPS address (ngrok in local dev) — Meta calls this directly for webhooks and
# needs it registered as a Valid OAuth Redirect URI too.
PUBLIC_MESSAGING_URL=http://localhost:8081/api/v1/messaging

# --- Ad account integrations (Integrations -> Ad Accounts tab) -----------------------------
# Meta Ads reuses META_APP_ID/META_APP_SECRET above — no separate app needed.
#
# TikTok: register a TikTok for Business developer app (business-api.tiktok.com) and get it
# approved for Marketing API (reporting/read) access.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
#
# Google Ads: create a Google Cloud OAuth 2.0 Client (Client ID/Secret) with this backend's
# /marketing/ad-accounts/google/oauth/callback URL registered as an authorized redirect URI, and
# a Developer Token from a Google Ads Manager account's API Center. A freshly-created developer
# token starts at "Test Account" access — it only works against Google Ads *test* accounts until
# Google approves Basic/Standard access.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- ZetSales Fraud Checker: Steadfast dashboard login --------------------------------------
# Logs into steadfast.com.bd's merchant dashboard (not the official Steadfast order API, which
# uses its own Api-Key/Secret-Key stored per-tenant in the database) to call their undocumented
# per-phone-number fraud-check endpoint. See steadfastFraudClient.ts. A real dashboard login,
# not an API key — treat it exactly like a password.
STEADFAST_PORTAL_EMAIL=
STEADFAST_PORTAL_PASSWORD=

# --- ZetSales Fraud Checker: Pathao merchant dashboard login --------------------------------
# Logs into merchant.pathao.com (not the official Pathao Developer API, which uses OAuth2
# client_id/client_secret and has no fraud-check feature) to call their undocumented per-phone
# customer-success-rate endpoint. See pathaoFraudClient.ts. A real dashboard login, not an API
# key — treat it exactly like a password.
PATHAO_PORTAL_USERNAME=
PATHAO_PORTAL_PASSWORD=
