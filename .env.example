JWT_SECRET=super-secret-key-change-me
MONGODB_URI=mongodb://localhost:27017/zetsales
PORT=3000
NODE_ENV=development

# --- Commerce integrations (Shopify / WooCommerce) -----------------------------------------
# Encrypts stored store credentials (Shopify access tokens, WooCommerce consumer secrets) at rest.
STORE_CREDENTIALS_SECRET=dev-store-credentials-secret-change-me

# Public URLs this backend is reachable at — used to build OAuth redirect / webhook callback URLs.
# For local dev these point at localhost; for a real Shopify OAuth or WooCommerce one-click
# connect flow to work, PUBLIC_COMMERCE_URL must be a real HTTPS address (e.g. via ngrok or a
# deployed server) — both platforms require HTTPS callbacks.
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_COMMERCE_URL=http://localhost:8081/api/v1/commerce

# Shopify: only needed for the one-click "Connect Shopify" OAuth flow. Create a Partner account +
# custom/public app at partners.shopify.com to get these. Not required for the "paste your
# access token" fallback connection method, which works today with no setup.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Used to verify Shopify order webhook signatures once webhooks are registered for a store.
SHOPIFY_WEBHOOK_SECRET=

# WooCommerce: no account/app registration needed for either connection method. This secret is
# only used to verify order webhook signatures once a webhook is registered on a connected store.
WOOCOMMERCE_WEBHOOK_SECRET=
